            .onclick =
                function () {

                    finishTrim();

                };


        document
            .getElementById(
                "snapzTrimPlay"
            )
            .onclick =
                function () {

                    playTrimPreview();

                };


        document
            .getElementById(
                "snapzTrimStart"
            )
            .addEventListener(
