        let panel =
            document.getElementById(
                "snapzPostReelTrimPanel"
            );

        if (panel) {

            panel.remove();

        }


        panel =
            document.createElement(
                "div"
            );

        panel.id =
            "snapzPostReelTrimPanel";

        panel.style.cssText = `
            position:fixed;
            inset:0;
            z-index:1000000001;
            background:#050505;
            color:#fff;
            font-family:Arial,sans-serif;
            overflow:hidden;
        `;


        panel.innerHTML = `

            <div style="
                height:64px;
                display:flex;
                align-items:center;
                justify-content:space-between;
                padding:0 18px;
                border-bottom:1px solid #242424;
                box-sizing:border-box;
            ">

                <button
                    id="snapzTrimBack"
                    type="button"
                    style="
                        background:none;
                        border:0;
                        color:#fff;
                        font-size:32px;
                        cursor:pointer;
                    "
                >‹</button>

                <b id="snapzTrimTitle">
                    Trim audio
                </b>

                <button
                    id="snapzTrimDone"
                    type="button"
                    style="
                        background:none;
