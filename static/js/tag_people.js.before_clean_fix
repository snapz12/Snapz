/* =========================================================
   SNAPZ — TAG PEOPLE
   Instagram-style mutual-follow tagging
   Maximum 5 people
========================================================= */

(function(){

    const MAX_TAGS = 5;

    let selectedTags = [];

    function injectStyles(){

        if(document.getElementById("snapzTagPeopleStyle")){
            return;
        }

        const style = document.createElement("style");

        style.id = "snapzTagPeopleStyle";

        style.textContent = `
        #snapzTagPeopleModal{
            position:fixed;
            inset:0;
            z-index:99999;
            background:rgba(0,0,0,.72);
            display:none;
            align-items:flex-end;
            justify-content:center;
        }

        #snapzTagPeoplePanel{
            width:100%;
            max-width:520px;
            max-height:82vh;
            background:#111318;
            color:#fff;
            border-radius:24px 24px 0 0;
            overflow:hidden;
            box-shadow:0 -10px 40px rgba(0,0,0,.5);
        }

        .snapzTagHeader{
            height:64px;
            display:flex;
            align-items:center;
            padding:0 18px;
            border-bottom:1px solid #292d35;
            box-sizing:border-box;
        }

        .snapzTagBack{
            width:42px;
            font-size:28px;
            cursor:pointer;
        }

        .snapzTagTitle{
            flex:1;
            text-align:center;
            font-size:19px;
            font-weight:600;
        }

        .snapzTagDone{
            width:42px;
            text-align:right;
            color:#ff3d81;
            font-weight:700;
            cursor:pointer;
        }

        .snapzTagSearchArea{
            padding:14px 16px 8px;
        }

        .snapzTagSearchBox{
            display:flex;
            align-items:center;
            gap:8px;
            background:#20242b;
            border-radius:12px;
            padding:0 12px;
            height:46px;
        }

        .snapzTagSearchBox input{
            flex:1;
            border:0;
            outline:0;
            background:transparent;
            color:#fff;
            font-size:16px;
        }

        .snapzTagSearchButton{
            border:0;
            background:#ff3d81;
            color:#fff;
            border-radius:9px;
            padding:8px 13px;
            font-weight:600;
            cursor:pointer;
        }

        .snapzTagCount{
            padding:5px 18px 10px;
            color:#aeb4bd;
            font-size:13px;
        }

        #snapzTagPeopleResults{
            overflow-y:auto;
            max-height:52vh;
            padding-bottom:15px;
        }

        .snapzTagUser{
            display:flex;
            align-items:center;
            gap:12px;
            padding:11px 18px;
        }

        .snapzTagUser:hover{
            background:#191c22;
        }

        .snapzTagAvatar{
            width:48px;
            height:48px;
            border-radius:50%;
            object-fit:cover;
            background:#292d35;
        }

        .snapzTagUsername{
            flex:1;
            font-size:16px;
            font-weight:600;
        }

        .snapzTagButton{
            border:0;
            border-radius:9px;
            padding:8px 16px;
            background:#ff3d81;
            color:#fff;
            font-weight:700;
            cursor:pointer;
        }

        .snapzTagButton.tagged{
            background:#292d35;
            color:#fff;
        }

        .snapzTagEmpty{
            text-align:center;
            padding:35px 20px;
            color:#9ba1aa;
        }
        `;

        document.head.appendChild(style);
    }


    function createModal(){

        if(document.getElementById("snapzTagPeopleModal")){
            return;
        }

        const modal = document.createElement("div");

        modal.id = "snapzTagPeopleModal";

        modal.innerHTML = `
            <div id="snapzTagPeoplePanel">

                <div class="snapzTagHeader">

                    <div
                        class="snapzTagBack"
                        id="snapzTagBack"
                    >‹</div>

                    <div class="snapzTagTitle">
                        Tag people
                    </div>

                    <div
                        class="snapzTagDone"
                        id="snapzTagDone"
                    >Done</div>

                </div>

                <div class="snapzTagSearchArea">

                    <div class="snapzTagSearchBox">

                        <span>⌕</span>

                        <input
                            id="snapzTagSearchInput"
                            type="text"
                            placeholder="Search username..."
                            autocomplete="off"
                        >

                        <button
                            type="button"
                            class="snapzTagSearchButton"
                            id="snapzTagSearchButton"
                        >
                            Search
                        </button>

                    </div>

                </div>

                <div
                    class="snapzTagCount"
                    id="snapzTagCount"
                >
                    0 / 5 tagged
                </div>

                <div id="snapzTagPeopleResults">
                    <div class="snapzTagEmpty">
                        Loading...
                    </div>
                </div>

            </div>
        `;

        /* =====================================================
           SNAPZ — TAG MODAL MUST BE DIRECT CHILD OF BODY
        ===================================================== */

        document.body.appendChild(modal);

        modal.style.setProperty(
            "position",
            "fixed",
            "important"
        );

        modal.style.setProperty(
            "top",
            "0",
            "important"
        );

        modal.style.setProperty(
            "left",
            "0",
            "important"
        );

        modal.style.setProperty(
            "right",
            "0",
            "important"
        );

        modal.style.setProperty(
            "bottom",
            "0",
            "important"
        );

        modal.style.setProperty(
            "width",
            "100vw",
            "important"
        );

        modal.style.setProperty(
            "height",
            "100vh",
            "important"
        );

        modal.style.setProperty(
            "z-index",
            "2147483647",
            "important"
        );

        modal.style.setProperty(
            "display",
            "none",
            "important"
        );


        modal.addEventListener("click", function(e){

            if(e.target === modal){
                closeTagPeople();
            }

        });


        document
            .getElementById("snapzTagBack")
            .addEventListener(
                "click",
                closeTagPeople
            );


        document
            .getElementById("snapzTagDone")
            .addEventListener(
                "click",
                closeTagPeople
            );


        document
            .getElementById("snapzTagSearchButton")
            .addEventListener(
                "click",
                function(){
                    loadTagPeople(
                        document
                            .getElementById("snapzTagSearchInput")
                            .value
                            .trim()
                    );
                }
            );


        document
            .getElementById("snapzTagSearchInput")
            .addEventListener(
                "keydown",
                function(e){

                    if(e.key === "Enter"){

                        loadTagPeople(
                            this.value.trim()
                        );

                    }

                }
            );
    }


    function openTagPeople(){

        console.log("SNAPZ OPEN TAG PEOPLE");

        injectStyles();
        createModal();

        const modal =
            document.getElementById(
                "snapzTagPeopleModal"
            );

        if(!modal){
            console.error(
                "SNAPZ TAG MODAL NOT CREATED"
            );
            return;
        }

        /*
         * Always move modal to document.body.
         * This prevents parent stacking/overflow problems.
         */
        if(modal.parentElement !== document.body){
            document.body.appendChild(modal);
        }

        /*
         * Force complete fullscreen modal.
         */
        const styles = {
            position: "fixed",
            top: "0",
            left: "0",
            right: "0",
            bottom: "0",
            width: "100vw",
            height: "100vh",
            display: "flex",
            visibility: "visible",
            opacity: "1",
            zIndex: "2147483647",
            pointerEvents: "auto"
        };

        Object.keys(styles).forEach(function(key){

            modal.style.setProperty(
                key,
                styles[key],
                "important"
            );

        });

        /*
         * Prevent page behind modal from scrolling.
         */
        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";

        updateCount();

        loadTagPeople("");

        console.log(
            "SNAPZ TAG MODAL OPENED",
            modal
        );

        console.log(
            "TAG MODAL DEBUG:",
            {
                parent: modal.parentElement
                    ? modal.parentElement.tagName
                    : null,

                display: getComputedStyle(modal).display,

                visibility: getComputedStyle(modal).visibility,

                opacity: getComputedStyle(modal).opacity,

                position: getComputedStyle(modal).position,

                zIndex: getComputedStyle(modal).zIndex,

                width: modal.getBoundingClientRect().width,

                height: modal.getBoundingClientRect().height,

                top: modal.getBoundingClientRect().top,

                left: modal.getBoundingClientRect().left,

                panel:
                    !!document.getElementById(
                        "snapzTagPeoplePanel"
                    )
            }
        );
    }

    function closeTagPeople(){

        const modal =
            document.getElementById(
                "snapzTagPeopleModal"
            );

        if(modal){
            modal.style.display = "none";
        }

    }


    async function loadTagPeople(query){

        const results =
            document.getElementById(
                "snapzTagPeopleResults"
            );

        if(!results){
            return;
        }

        results.innerHTML = `
            <div class="snapzTagEmpty">
                Loading...
            </div>
        `;

        try{

            const response =
                await fetch(
                    "/tag_people_users?q=" +
                    encodeURIComponent(query || "")
                );

            if(!response.ok){
                throw new Error(
                    "Tag people request failed"
                );
            }

            const users =
                await response.json();

            renderUsers(users);

        }catch(error){

            console.error(
                "TAG PEOPLE ERROR =",
                error
            );

            results.innerHTML = `
                <div class="snapzTagEmpty">
                    Unable to load people.
                </div>
            `;

        }

    }


    function renderUsers(users){

        const results =
            document.getElementById(
                "snapzTagPeopleResults"
            );

        if(!results){
            return;
        }

        if(!users || !users.length){

            results.innerHTML = `
                <div class="snapzTagEmpty">
                    No mutual followers found.
                </div>
            `;

            return;
        }

        let html = "";

        users.forEach(function(user){

            const username =
                user.username;

            const isTagged =
                selectedTags.includes(
                    username
                );

            html += `
                <div class="snapzTagUser">

                    <img
                        class="snapzTagAvatar"
                        src="${escapeHtml(user.profile_pic || "/static/default.png")}"
                        onerror="this.src='/static/default.png'"
                    >

                    <div class="snapzTagUsername">
                        ${escapeHtml(username)}
                    </div>

                    <button
                        type="button"
                        class="snapzTagButton ${isTagged ? "tagged" : ""}"
                        onclick="snapzToggleTag('${escapeJs(username)}')"
                    >
                        ${isTagged ? "Tagged ✓" : "Tag"}
                    </button>

                </div>
            `;

        });

        results.innerHTML = html;

    }


    window.snapzToggleTag =
        function(username){

            const index =
                selectedTags.indexOf(
                    username
                );

            if(index !== -1){

                selectedTags.splice(
                    index,
                    1
                );

            }else{

                if(
                    selectedTags.length >= MAX_TAGS
                ){

                    alert(
                        "Maximum 5 people can be tagged."
                    );

                    return;
                }

                selectedTags.push(
                    username
                );

            }

            updateCount();

            const queryInput =
                document.getElementById(
                    "snapzTagSearchInput"
                );

            loadTagPeople(
                queryInput
                    ? queryInput.value.trim()
                    : ""
            );

        };


    function updateCount(){

        const count =
            document.getElementById(
                "snapzTagCount"
            );

        if(count){

            count.textContent =
                selectedTags.length +
                " / " +
                MAX_TAGS +
                " tagged";

        }

    }


    window.snapzGetTaggedPeople =
        function(){

            return selectedTags.slice();

        };


    window.snapzResetTaggedPeople =
        function(){

            selectedTags = [];

            updateCount();

        };


    function escapeHtml(value){

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    function escapeJs(value){

        return String(value)
            .replace(/\\/g, "\\\\")
            .replace(/'/g, "\\'");

    }


    window.snapzOpenTagPeople =
        openTagPeople;


    document.addEventListener(
        "DOMContentLoaded",
        function(){

            injectStyles();
            createModal();

        }
    );

    
    

    /* =========================================================
       SNAPZ — FINAL TAG PEOPLE BUTTON HANDLER
    ========================================================= */

    document.addEventListener(
        "click",
        function(e){

            const button =
                e.target.closest(
                    "#snapzTagPeopleButton"
                );

            if(!button){
                return;
            }

            console.log(
                "SNAPZ TAG PEOPLE BUTTON CLICK"
            );

            e.preventDefault();
            e.stopPropagation();

            openTagPeople();

        },
        true
    );


})();
